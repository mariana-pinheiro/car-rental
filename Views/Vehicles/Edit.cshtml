@model CarRental.Models.Vehicle

@{
    ViewData["Title"] = "Editar veículo";
}

<div class="page-header">
    <div>
        <h1>Editar veículo</h1>
        <p>Atualize as informações de @Model.Brand @Model.Model.</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        ← Voltar
    </a>
</div>

<div class="app-card">

    <div class="mb-4">
        <h2 class="section-title">Informações do veículo</h2>
        <p class="section-description">
            Altere os dados necessários e guarde as modificações.
        </p>
    </div>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="row g-4">

            <div class="col-md-6">
                <label asp-for="Brand" class="form-label">
                    Marca
                </label>

                <input asp-for="Brand"
                       class="form-control" />

                <span asp-validation-for="Brand"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Model" class="form-label">
                    Modelo
                </label>

                <input asp-for="Model"
                       class="form-control" />

                <span asp-validation-for="Model"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="LicensePlate" class="form-label">
                    Matrícula
                </label>

                <input asp-for="LicensePlate"
                       class="form-control" />

                <span asp-validation-for="LicensePlate"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="ManufacturingYear" class="form-label">
                    Ano de fabrico
                </label>

                <input asp-for="ManufacturingYear"
                       type="number"
                       class="form-control" />

                <span asp-validation-for="ManufacturingYear"
                      class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="FuelType" class="form-label">
                    Tipo de combustível
                </label>

                <select asp-for="FuelType" class="form-select">
                    <option value="">Selecione o combustível</option>
                    <option value="Gasolina">Gasolina</option>
                    <option value="Diesel">Diesel</option>
                    <option value="Híbrido">Híbrido</option>
                    <option value="Elétrico">Elétrico</option>
                </select>

                <span asp-validation-for="FuelType"
                      class="text-danger"></span>
            </div>

        </div>

        <hr class="my-4" />

        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Guardar alterações
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}