@model CarRental.Models.RentalContract

@{
    ViewData["Title"] = "Novo contrato";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
}

<div class="page-header">
    <div>
        <h1>Novo contrato</h1>
        <p>Registe um novo aluguer no sistema.</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        ← Voltar
    </a>
</div>

<div class="app-card">

    <div class="mb-4">
        <h2 class="section-title">Informações do aluguer</h2>
        <p class="section-description">
            Selecione o cliente, o veículo e defina os dados do aluguer.
        </p>
    </div>

    <form asp-action="Create" method="post">

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-4">

            <div class="col-md-6">
                <label asp-for="ClientId" class="form-label">
                    Cliente
                </label>

                <select asp-for="ClientId" id="clientSelect" class="form-select">
                    <option value="">Pesquisar cliente...</option>
                </select>

                <span asp-validation-for="ClientId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="VehicleId" class="form-label">
                    Veículo
                </label>

                <select asp-for="VehicleId" id="vehicleSelect" class="form-select">
                    <option value="">Pesquisar veículo...</option>
                </select>

                <span asp-validation-for="VehicleId" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="StartDate" class="form-label">
                    Data de início
                </label>

                <input asp-for="StartDate" id="startDate" type="text" class="form-control"
                       placeholder="Selecione primeiro um veículo" readonly />

                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="EndDate" class="form-label">
                    Data de fim
                </label>
                <input asp-for="EndDate" id="endDate" type="text" class="form-control"
                       placeholder="Selecione primeiro um veículo" readonly />

                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="InitialMileage" class="form-label">
                    Quilometragem inicial
                </label>

                <div class="input-group">
                    <input asp-for="InitialMileage" type="number" min="0" class="form-control" />

                    <span class="input-group-text">km</span>
                </div>

                <span asp-validation-for="InitialMileage" class="text-danger"></span>
            </div>

        </div>

        <hr class="my-4" />

        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Index" class="btn btn-secondary">
                Cancelar
            </a>

            <button type="submit" class="btn btn-primary">
                Criar contrato
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/pt.js"></script>

    <script>
        new TomSelect("#clientSelect", {
            valueField: "id",
            labelField: "text",
            searchField: "text",
            placeholder: "Pesquisar por nome ou email...",
            maxOptions: 20,
            preload: true,

            load: function (query, callback) {
                fetch(`/RentalContracts/SearchClients?term=${encodeURIComponent(query)}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error("Erro ao pesquisar clientes.");
                        }

                        return response.json();
                    })
                    .then(data => callback(data))
                    .catch(() => callback());
            },

            render: {
                no_results: function () {
                    return '<div class="no-results">Nenhum cliente encontrado</div>';
                }
            }
        });

        let unavailablePeriods = [];


        const startCalendar = flatpickr("#startDate", {
            locale: "pt",
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "d/m/Y",
            minDate: "today",
            disable: [],
            clickOpens: false,

            onChange: function (selectedDates) {
                if (selectedDates.length === 0) {
                    endCalendar.clear();
                    return;
                }

                const selectedStart = selectedDates[0];

                const minimumEndDate = new Date(
                    selectedStart.getFullYear(),
                    selectedStart.getMonth(),
                    selectedStart.getDate() + 1
                );

                endCalendar.set("minDate", minimumEndDate);

                endCalendar.clear();

                endCalendar.jumpToDate(minimumEndDate);
            }
        });


        const endCalendar = flatpickr("#endDate", {
            locale: "pt",
            dateFormat: "Y-m-d",
            altInput: true,
            altFormat: "d/m/Y",
            minDate: "today",
            disable: [],
            clickOpens: false
        });


        const vehicleSelect = new TomSelect("#vehicleSelect", {
            valueField: "id",
            labelField: "text",
            searchField: "text",
            placeholder: "Pesquisar por marca, modelo ou matrícula...",
            maxOptions: 20,
            preload: true,

            load: function (query, callback) {
                fetch(`/RentalContracts/SearchVehicles?term=${encodeURIComponent(query)}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error("Erro ao pesquisar veículos.");
                        }

                        return response.json();
                    })
                    .then(data => callback(data))
                    .catch(() => callback());
            },

            onChange: function (vehicleId) {
                startCalendar.clear();
                endCalendar.clear();

                if (!vehicleId) {
                    unavailablePeriods = [];

                    startCalendar.set("disable", []);
                    endCalendar.set("disable", []);

                    startCalendar.set("clickOpens", false);
                    endCalendar.set("clickOpens", false);

                    return;
                }

                fetch(`/RentalContracts/VehicleAvailability?vehicleId=${vehicleId}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error("Erro ao obter disponibilidade.");
                        }

                        return response.json();
                    })
                    .then(periods => {
                        unavailablePeriods = periods.map(period => ({
                            from: period.startDate,
                            to: period.endDate
                        }));

                        startCalendar.set("disable", unavailablePeriods);
                        endCalendar.set("disable", unavailablePeriods);

                        startCalendar.set("clickOpens", true);
                        endCalendar.set("clickOpens", true);
                    })
                    .catch(error => {
                        console.error(error);

                        startCalendar.set("clickOpens", false);
                        endCalendar.set("clickOpens", false);
                    });
            },

            render: {
                no_results: function () {
                    return '<div class="no-results">Nenhum veículo encontrado</div>';
                }
            }
        });
    </script>
}