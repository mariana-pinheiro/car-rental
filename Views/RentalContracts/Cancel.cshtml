@model CarRental.Models.RentalContract

@{
    ViewData["Title"] = "Cancelar contrato";
}

<div class="page-header">
    <div>
        <h1>Cancelar contrato</h1>
        <p>Confirme o cancelamento deste aluguer.</p>
    </div>

    <a asp-action="Details"
       asp-route-id="@Model.Id"
       class="btn btn-secondary">
        ← Voltar
    </a>
</div>

<div class="app-card">

    <div class="mb-4">
        <h2 class="section-title">Confirmar cancelamento</h2>
        <p class="section-description">
            O contrato continuará disponível no histórico, mas o veículo
            ficará novamente disponível para este período.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <label class="form-label">Cliente</label>
            <p class="mb-0">
                <strong>@Model.Client?.FullName</strong>
            </p>
        </div>

        <div class="col-md-6">
            <label class="form-label">Veículo</label>
            <p class="mb-0">
                <strong>
                    @Model.Vehicle?.Brand @Model.Vehicle?.Model
                </strong>
            </p>
            <span class="text-secondary">
                @Model.Vehicle?.LicensePlate
            </span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Data de início</label>
            <p class="mb-0">
                @Model.StartDate.ToString("dd/MM/yyyy")
            </p>
        </div>

        <div class="col-md-6">
            <label class="form-label">Data de fim</label>
            <p class="mb-0">
                @Model.EndDate.ToString("dd/MM/yyyy")
            </p>
        </div>

    </div>

    <hr class="my-4" />

    <form asp-action="Cancel"
          asp-route-id="@Model.Id"
          method="post">

        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Details"
               asp-route-id="@Model.Id"
               class="btn btn-secondary">
                Voltar
            </a>

            <button type="submit"
                    class="btn btn-danger">
                Cancelar contrato
            </button>

        </div>

    </form>

</div>