@model CarRental.Models.RentalContract

@{
    ViewData["Title"] = "Editar contrato";
    var isActive = ViewBag.IsActive == true;
}

<div class="page-header">
    <div>
        <h1>Editar contrato</h1>
        <p>
            @(isActive
                ? "Atualize a data de fim do aluguer ativo."
                : "Atualize os dados do aluguer.")
        </p>
    </div>

    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
        ← Voltar
    </a>
</div>

<div class="app-card">

    <div class="mb-4">
        <h2 class="section-title">Dados do contrato</h2>

        <p class="section-description">
            @(isActive
                ? "Este aluguer já está ativo. Apenas a data de fim pode ser alterada."
                : "Altere as informações necessárias.")
        </p>
    </div>

    <form asp-action="Edit" method="post">

        <input type="hidden" name="Id" value="@Model.Id" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        @if (isActive)
        {
            <input type="hidden" name="ClientId" value="@Model.ClientId" />

            <input type="hidden" name="VehicleId" value="@Model.VehicleId" />

            <input type="hidden" name="StartDate" value="@(Model.StartDate.ToString("yyyy-MM-dd"))" />

            <input type="hidden" name="InitialMileage" value="@Model.InitialMileage" />

            <div class="row g-4">

                <div class="col-md-6">
                    <label class="form-label">Cliente</label>
                    <input type="text" class="form-control" value="@ViewBag.ClientName" disabled />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Veículo</label>
                    <input type="text" class="form-control" value="@ViewBag.VehicleDescription" disabled />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Data de início</label>
                    <input type="date" class="form-control" value="@(Model.StartDate.ToString("yyyy-MM-dd"))" disabled />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Data de fim</label>
                    <input name="EndDate" type="date" class="form-control"
                           value="@(Model.EndDate.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Quilometragem inicial
                    </label>

                    <div class="input-group">
                        <input type="number" class="form-control" value="@Model.InitialMileage" disabled />

                        <span class="input-group-text">km</span>
                    </div>
                </div>

            </div>
        }
        else
        {
            <div class="row g-4">

                <div class="col-md-6">
                    <label class="form-label">Cliente</label>
                    <select name="ClientId" class="form-select">
                        <option value="">Selecione um cliente</option>

                        @foreach (var client in ViewBag.Clients)
                        {
                            <option value="@client.Value" selected="@(client.Value == Model.ClientId.ToString())">
                                @client.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Veículo</label>

                    <select name="VehicleId" class="form-select">
                        <option value="">Selecione um veículo</option>

                        @foreach (var vehicle in ViewBag.Vehicles)
                        {
                            <option value="@vehicle.Value" selected="@(vehicle.Value == Model.VehicleId.ToString())">
                                @vehicle.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Data de início</label>

                    <input name="StartDate" type="date" class="form-control"
                           value="@(Model.StartDate.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">Data de fim</label>

                    <input name="EndDate" type="date" class="form-control"
                           value="@(Model.EndDate.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">
                        Quilometragem inicial
                    </label>

                    <div class="input-group">
                        <input name="InitialMileage" type="number" min="0" class="form-control"
                               value="@Model.InitialMileage" />

                        <span class="input-group-text">km</span>
                    </div>
                </div>

            </div>
        }

        <hr class="my-4" />

        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                Cancelar
            </a>

            <button type="submit" class="btn btn-primary">
                Guardar alterações
            </button>

        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}