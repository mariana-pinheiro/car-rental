@model CarRental.Models.Client

@{
    ViewData["Title"] = "Eliminar cliente";
}

<div class="page-header">
    <div>
        <h1>Eliminar cliente</h1>
        <p>Confirme a eliminação do cliente selecionado.</p>
    </div>

    <a asp-action="Index" class="btn btn-secondary">
        ← Voltar
    </a>
</div>

<div class="app-card">

    <div class="mb-4">
        <h2 class="section-title">Tem a certeza?</h2>

        <p class="section-description">
            Esta ação irá remover o cliente do sistema.
        </p>
    </div>

    <div class="p-4 rounded-3 bg-light mb-4">

        <div class="row g-4">

            <div class="col-md-6">
                <label class="form-label">Nome completo</label>
                <p class="mb-0 fw-semibold">
                    @Model.FullName
                </p>
            </div>

            <div class="col-md-6">
                <label class="form-label">Email</label>
                <p class="mb-0">
                    @Model.Email
                </p>
            </div>

            <div class="col-md-6">
                <label class="form-label">Telefone</label>
                <p class="mb-0">
                    @Model.Phone
                </p>
            </div>

            <div class="col-md-6">
                <label class="form-label">Carta de condução</label>
                <p class="mb-0">
                    @Model.DrivingLicense
                </p>
            </div>

        </div>

    </div>

    <div class="alert alert-danger">
        <strong>Atenção:</strong>
        esta ação não pode ser anulada.
    </div>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>

            <button type="submit"
                    class="btn btn-danger">
                Eliminar cliente
            </button>

        </div>

    </form>

</div>