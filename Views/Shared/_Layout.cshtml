<!DOCTYPE html>
<html lang="pt">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CarRental</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarRental.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div class="app-layout">

        <aside class="sidebar">

            <div class="sidebar-brand">
                <div class="user-avatar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 17h14" />
                        <path d="M6 17v2" />
                        <path d="M18 17v2" />
                        <path d="M3 13l2-5a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 5" />
                        <rect x="3" y="13" width="18" height="4" rx="1" />
                        <circle cx="7" cy="15" r="1" />
                        <circle cx="17" cy="15" r="1" />
                    </svg>
                </div>

                <div>
                    <h2>CarRental</h2>
                    <span>Aluguer de Carros</span>
                </div>
            </div>

            <nav class="sidebar-nav">

                <a asp-controller="Home" asp-action="Index" class="nav-item">
                    <span class="nav-icon">⌂</span>
                    Dashboard
                </a>

                <a asp-controller="Vehicles" asp-action="Index" class="nav-item">
                    <span class="nav-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 17h14" />
                            <path d="M6 17v2" />
                            <path d="M18 17v2" />
                            <path d="M3 13l2-5a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 5" />
                            <rect x="3" y="13" width="18" height="4" rx="1" />
                            <circle cx="7" cy="15" r="1" />
                            <circle cx="17" cy="15" r="1" />
                        </svg>
                    </span>

                    Veículos
                </a>

                <a asp-controller="Clients" asp-action="Index" class="nav-item">
                    <span class="nav-icon">♙</span>
                    Clientes
                </a>

                <a asp-controller="RentalContracts" asp-action="Index" class="nav-item">
                    <span class="nav-icon">▤</span>
                    Contratos
                </a>

            </nav>

            <div class="sidebar-footer">
                <p>Sistema de Gestão</p>
                <span>CarRental © 2026</span>
            </div>

        </aside>

        <main class="main-content">

            <header class="topbar">
                <div>
                    <span class="topbar-label">ALUGUER</span>
                </div>

                <div class="user-profile">
                    <div class="user-avatar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 17h14" />
                            <path d="M6 17v2" />
                            <path d="M18 17v2" />
                            <path d="M3 13l2-5a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 5" />
                            <rect x="3" y="13" width="18" height="4" rx="1" />
                            <circle cx="7" cy="15" r="1" />
                            <circle cx="17" cy="15" r="1" />
                        </svg>
                    </div>

                    <div>
                        <strong>Administrador</strong>
                        <span>CarRental</span>
                    </div>
                </div>
            </header>

            <div class="page-content">
                @RenderBody()
            </div>

        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>