<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CarRental</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CarRental.styles.css" asp-append-version="true" />
</head>

<body>

    <div class="app-layout">

        <aside class="sidebar">

            <div class="sidebar-brand">
                <div class="brand-icon">
                    CR
                </div>

                <div>
                    <h2>CarRental</h2>
                    <span>Fleet Management</span>
                </div>
            </div>

            <nav class="sidebar-nav">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="nav-item">
                    <span class="nav-icon">⌂</span>
                    Dashboard
                </a>

                <a asp-controller="Vehicles"
                   asp-action="Index"
                   class="nav-item">
                    <span class="nav-icon">◇</span>
                    Veículos
                </a>

                <a asp-controller="Clients"
                   asp-action="Index"
                   class="nav-item">
                    <span class="nav-icon">♙</span>
                    Clientes
                </a>

                <a asp-controller="RentalContracts"
                   asp-action="Index"
                   class="nav-item">
                    <span class="nav-icon">▤</span>
                    Contratos
                </a>

            </nav>

            <div class="sidebar-footer">
                <p>Sistema de Gestão</p>
                <span>CarRental © 2026</span>
            </div>

        </aside>

        <main class="main-content">

            <header class="topbar">
                <div>
                    <span class="topbar-label">GESTÃO DE FROTA</span>
                </div>

                <div class="user-profile">
                    <div class="user-avatar">
                        SP
                    </div>

                    <div>
                        <strong>Administrador</strong>
                        <span>CarRental</span>
                    </div>
                </div>
            </header>

            <div class="page-content">
                @RenderBody()
            </div>

        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>